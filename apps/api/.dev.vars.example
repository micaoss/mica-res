# Local `wrangler dev` configuration. Copy to `.dev.vars` (gitignored) and
# fill in. These mirror the secrets you would set with `wrangler secret put`
# for a real deployment.
NODE_ENV=development
BASE_PATH=
LOG_LEVEL=warn
LOG_TO_STDOUT=true
DEFAULT_ADMIN=admin@example.com
# Single-user login for the smoke test (tests/workers/smoke.ts).
# The hash below is PBKDF2 — argon2/bcrypt cannot be verified on Workers.
SINGLE_USER_MODE=true
SINGLE_USER_USERNAME=smoke
SINGLE_USER_PASSWORD_HASH="pbkdf2-sha256$600000$jr/n8EtQxPIQbk97B8ZbIA==$NWQeG00mf6dEAYRGllsUSIQW85wtuRkKzf6SZ9whxRI="

# Keep the creation caps low so the smoke test can reach them quickly.
CREATE_RATE_LIMIT_PER_MINUTE=10
CREATE_RATE_LIMIT_PER_HOUR=1000
