# Local `wrangler dev` configuration. Copy to `.dev.vars` (gitignored) and
# fill in. These mirror the secrets you would set with `wrangler secret put`
# for a real deployment.
NODE_ENV=development
BASE_PATH=/admin
LOG_LEVEL=warn
LOG_TO_STDOUT=true
DEFAULT_ADMIN=admin@example.com
# Single-user login for the smoke test (tests/workers/smoke.ts).
# PBKDF2 at 100,000 iterations: argon2/bcrypt cannot be verified on Workers,
# and Workers refuses PBKDF2 above that ceiling.
SINGLE_USER_MODE=true
SINGLE_USER_USERNAME=smoke
SINGLE_USER_PASSWORD_HASH="pbkdf2-sha256$100000$EcnP8V365V1RKqQ1Q1GuEA==$gTZf4kkRCaQlL74BxA3KT/mc6Dbk4KuIeC9vJB7UT+M="

# Keep the creation caps low so the smoke test can reach them quickly.
CREATE_RATE_LIMIT_PER_MINUTE=10
CREATE_RATE_LIMIT_PER_HOUR=1000

# The resource service under wrangler dev: local R2 buckets, no S3 API, so
# uploads and signed URLs fail; publishing by copy and every read path work.
APP_URL=http://127.0.0.1:8787
# wrangler dev rewrites Host and Origin to the first route (res.micaos.dev),
# so the rewritten origin has to be allowed as well as the local one.
CORS_ORIGIN=http://127.0.0.1:8787,http://res.micaos.dev
RES_HOME_URL=http://127.0.0.1:8787
RES_DOWNLOAD_URL=http://127.0.0.1:8787/_dev-download
RES_S3_URL=http://s3.localhost:8787
