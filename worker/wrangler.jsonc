{
  // The only public surface of the private bucket: blobs by digest, the index,
  // readable download paths resolved through the index, and the generated site.
  // The assets are in R2, not in the deployment, so there is no `assets`
  // directory; the sync uploads them.
  "name": "mica-res",
  "compatibility_date": "2026-09-16",
  "main": "./src/index.ts",
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "res-micaos-dev" }
  ],
  // The sync runs in GitHub Actions, so this Worker has no scheduled work.
  // res.micaos.dev is a third custom domain on the micaos.dev zone, next to
  // the website Worker's micaos.dev and www.micaos.dev; the zone has to be on
  // the same Cloudflare account.
  "routes": [
    { "pattern": "res.micaos.dev", "custom_domain": true }
  ]
}
